# EdgeBot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── Binance Exchange ──────────────────────────────────────────────────────────
# Read-only API key for market data; add trading permissions for live mode.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Set to "true" to connect to Binance testnet (paper trading) instead of mainnet.
BINANCE_TESTNET=true

# ── Telegram Notifications ────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat or group ID where trade alerts will be sent.
# Use @userinfobot to find your chat ID.
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Portfolio ─────────────────────────────────────────────────────────────────
# Starting cash balance in quote currency (USDT / USD).
INITIAL_CASH=10000

# ── Execution Mode ────────────────────────────────────────────────────────────
# "true" = paper trading (no real orders), "false" = live trading.
PAPER_TRADE=true

# ── Risk Parameters ───────────────────────────────────────────────────────────
# Maximum position size as fraction of NAV (0.02 = 2%).
MAX_POSITION_SIZE_PCT=0.02

# Daily loss limit as fraction of NAV (0.05 = 5%). Trips the circuit breaker.
DAILY_LOSS_LIMIT_PCT=0.05

# Maximum number of simultaneously open positions.
MAX_OPEN_POSITIONS=3

# Minimum acceptable risk-reward ratio. Signals with R:R below this are rejected.
MIN_RISK_REWARD_RATIO=2.0

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
DB_PATH=data/edgebot.db

# ── InfluxDB Metrics (optional) ───────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=edgebot
INFLUXDB_BUCKET=trading_metrics

# ── Grafana (optional) ────────────────────────────────────────────────────────
# Grafana admin password — change before deploying to any non-local environment.
GF_SECURITY_ADMIN_PASSWORD=changeme

# ── Logging ───────────────────────────────────────────────────────────────────
# Python log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO